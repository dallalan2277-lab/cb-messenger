# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.  (copy .env.example .env)
# .env 에는 API 키가 들어갈 수 있으므로 절대 다른 사람과 공유하지 마세요.

# ---- 용도별 모델 (테스트 화면의 [모델 설정]에서도 바꿀 수 있음) ----
# 형식: 제공자  또는  제공자:모델
#   chatgpt_plan : ChatGPT Plus/Pro 구독 (2_ChatGPT로그인.bat 먼저)   ← 추가 비용 없음
#   claude_cli   : Claude Pro/Max 구독 (Claude Code 설치·로그인 필요)  ← 추가 비용 없음
#   openai       : OpenAI API 키 (사용량 결제)
#   claude       : Anthropic API 키 (사용량 결제)
#   fake         : 키 없이 화면·흐름만 테스트
# 예) AI_ANALYZE=chatgpt_plan:gpt-5.6-luna   AI_DIGEST=chatgpt_plan:gpt-6-astra   AI_FALLBACK=claude_cli:haiku
#   ChatGPT 구독으로 쓸 수 있는 모델 이름 보기: python main.py chatgpt-models

# 분석 모델: 메시지마다 호출 → 가볍고 빠른 모델 권장 (모델 비우면 자동 선택)
AI_ANALYZE=chatgpt_plan
# 브리핑 모델: 하루 몇 번 → 좋은 모델 써도 부담 적음 (비우면 분석 모델과 같음)
AI_DIGEST=
# 대체 모델: 위 모델이 한도 초과·로그인 만료 등으로 실패하면 사용 (비우면 없음)
AI_FALLBACK=
# 사고 수준: default | low | medium | high  (GPT 계열에만 적용, 낮을수록 토큰 절약)
AI_REASONING=default

# ---- 토큰 절약: 아래에 해당하면 AI 를 부르지 않고 '참고'로 저장 ----
SKIP_AI_KEYWORDS=식단표,급식,생일 축하,감사합니다
SKIP_AI_MIN_CHARS=6

# 모델을 안 적었을 때 제공자별 기본 모델
CHATGPT_PLAN_MODEL=
CLAUDE_CLI_MODEL=

# API 키 사용 시
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# ---- 사용자 정보 (중요도 판단에 참고) ----
USER_ROLE=초등학교 담임교사

# ---- 개인정보 가리기 ----
REDACT_ENABLED=true
# 학생 이름처럼 자동으로 못 찾는 단어를 쉼표로 등록 (AI로 보내기 전에 [이름1] 등으로 바뀜)
REDACT_NAMES=

# ---- 요약 대상 필터 (보낸 사람 이름에 포함된 글자, 쉼표 구분, 비우면 전체) ----
INCLUDE_SENDERS=
EXCLUDE_SENDERS=
# 메신저에 표시되는 내 이름 (쉼표로 여러 개) — 보낸 사람이 정확히 이 이름인 쪽지(내가 보낸 쪽지)는 저장·분석 안 함
MY_NAMES=

# ---- 네이버 메일 (설정 화면 [메일] 탭 또는 8_메일연결.bat 으로 연결하면 자동으로 채워짐) ----
# 비밀번호는 여기에 쓰지 않습니다 → Windows 자격 증명 관리자에 저장
MAIL_ENABLED=false
MAIL_ACCOUNT=
# 확인 간격(분): 1 / 2 / 5 / 10
MAIL_INTERVAL_MIN=2

# ---- 학교 정보 (AI 의 '학교 업무' 판단에 참고, 모두 선택) ----
SCHOOL_NAME=
SCHOOL_DUTIES=
SCHOOL_SENDERS=

# ---- 알림 (쪽지·메일 공통) ----
NOTIFY_ENABLED=true
# school(학교 업무만, 기본) | important(긴급·중요) | all(모든 것)
NOTIFY_SCOPE=school
# 위 범위에서 긴급만
NOTIFY_HIGH_ONLY=false
NOTIFY_SOURCES=eztalk,mail
NOTIFY_SOUND=false
# 알림에 보낸 사람·제목·요약 보이기 (기본 숨김)
NOTIFY_PREVIEW=false
NOTIFY_QUIET=true
NOTIFY_QUIET_START=22:00
NOTIFY_QUIET_END=08:00

# ---- 바탕화면 캘린더 ----
# AI 가 쪽지에서 찾은 일정을 캘린더에 '제안'(점선)으로 올림 → 캘린더에서 확정/무시
CALENDAR_AUTO_SUGGEST=true
# 제안 단계 없이 바로 확정 (AI 가 날짜를 잘못 계산할 수 있어 권장하지 않음)
CALENDAR_AUTO_CONFIRM=false
# 위치·크기·투명도·주 시작 요일 등은 캘린더 화면의 ⚙ 에서 바꾸면 data\calendar_prefs.json 에 저장됨

# ---- 소통메신저 감시 (Windows) ----
# eztalk: 소통메신저 쪽지 창(알림 TFrmAlarm / 보기 TFrmViewNote)을 읽음 ← 기본, Project Monday 와 같은 방식
# notification: Windows 알림 센터를 읽음 (예비용)
MESSENGER_COLLECTOR=eztalk
MESSENGER_PROCESS=eztalk.exe
# 알림 창 → 보기 창으로 같은 쪽지가 연달아 읽히면 이 시간(초) 기다렸다가 한 건으로 합침
MESSENGER_QUIET_SEC=5
POLL_INTERVAL_SEC=0.5
MESSENGER_APP_KEYWORDS=소통메신저,충북

# ---- 쪽지 원문·요약 보관: 이 PC / 구글 드라이브 따로 켜고 끔 ----
# 이 PC: 원문 그대로 저장 (비우면 ./data/쪽지기록)
ARCHIVE_LOCAL=true
ARCHIVE_LOCAL_DIR=
# 구글 드라이브: 'Google Drive 데스크톱' 동기화 폴더에 파일을 씀 (비우면 G:\내 드라이브 등에서 자동으로 찾아
#   그 아래 '충북메신저AI_쪽지기록' 폴더 사용). 못 쓰면 이 PC의 '드라이브_대기' 폴더에 임시 보관.
ARCHIVE_GDRIVE=false
ARCHIVE_GDRIVE_DIR=
# 드라이브(클라우드)에는 개인정보를 가린 원문을 저장 (권장)
ARCHIVE_GDRIVE_REDACT=true
# 파일 형식: txt | md
ARCHIVE_FORMAT=txt
# AI 요약도 쪽지요약_YYYY-MM 파일로 저장
ARCHIVE_SUMMARY=true
# 보관할 수집 경로 (테스트 입력 manual 은 기본 제외)
ARCHIVE_SOURCES=eztalk,notification

# ---- 저장 위치 (비우면 ./data/messages.db) ----
# DB_PATH=

# ---- 업데이트 ----
# 저장소의 Releases는 공개되어 있어야 합니다.
UPDATE_CHECK=1
UPDATE_REPO=dallalan2277-lab/cb-messenger
